<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Game statistics</title>
		<link href="style.css" rel="stylesheet">
		<script type="text/javascript" src="statistics.js"></script>
    </head>
    <body>
		<div class="centered stats-page">
		<div>
			<h1>Game statistics</h1>
			<p>Various statistics about the games I've played, because statistics are fun.</p>
		</div>
		<div id ="controls">
			<a class="nav-button" href="games-played.html">Back to main list</a>
		</div>
			<div class="table-wrap">
				<h3>By release year</h3>
				<div class="chart-wrap">
					REPLACE_RELEASE_YEAR_CHART
				</div>
				<h3>By platform</h3>
				<table class="stats-table">
					<thead>
						<tr>
							<th>Platform</th>
							<th>Count</th>
						</tr>
					</thead>
					<tbody>
						REPLACE_PLATFORM_ROWS
					</tbody>
				</table>
				<h3>By genre</h3>
			<table class="stats-table">
				<thead>
					<tr>
						<th>Genre</th>
						<th>Count</th>
					</tr>
				</thead>
				<tbody>
					REPLACE_GENRE_ROWS
				</tbody>
			</table>
		</div>
	</div>
    </body>
</html>
